# Copy this file to .env.production on the deployment host and replace every
# CHANGE_ME value before starting production services. The backend refuses to
# start in NODE_ENV=production while required values are missing, placeholders
# remain, or CORS_ORIGIN is "*". Do not commit real secrets.

COMPOSE_PROJECT_NAME=vacuum-traceability-prod

# PostgreSQL
POSTGRES_DB=vacuum_traceability
POSTGRES_USER=vacuum_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://vacuum_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/vacuum_traceability?schema=public

# MinIO / S3-compatible object storage. The bucket must remain private; the
# backend returns short-lived signed URLs to Admin and never exposes credentials.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_BUCKET=vacuum-photos
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_USE_SSL=false
# Optional. MinIO ignores it; set it when pointing at real AWS S3.
S3_REGION=us-east-1

# Backend. Restrict CORS_ORIGIN to approved Admin/mobile/API origins.
NODE_ENV=production
PORT=3000
APP_NAME=vacuum-traceability-api
CORS_ORIGIN=https://vacuum-admin.example.com,https://vacuum-api.example.com
BACKEND_PUBLIC_URL=https://vacuum-api.example.com
ADMIN_PUBLIC_URL=https://vacuum-admin.example.com
FIREBASE_SERVICE_ACCOUNT_PATH=

# Local loopback ports for a host-level TLS reverse proxy. PostgreSQL and MinIO
# are intentionally not published by production compose.
BACKEND_HTTP_PORT=3000
ADMIN_HTTP_PORT=8080

# Image names/tags. Replace "local" with a release tag in production.
BACKEND_IMAGE=vacuum-traceability-backend
BACKEND_MIGRATION_IMAGE=vacuum-traceability-backend-migration
ADMIN_IMAGE=vacuum-traceability-admin
IMAGE_TAG=local
